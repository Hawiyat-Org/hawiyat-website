# ============================================
# Hawiyat environment variables
# Copy to .env and fill in real values. Never commit secrets.
# ============================================

# ============================================
# Database (required by Prisma)
# ============================================
DATABASE_URL=postgresql://user:password@localhost:5432/hawiyat_db

# ============================================
# App
# ============================================
NEXT_PUBLIC_APP_NAME=Hawiyat
NEXT_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=https://app.hawiyat.org
NEXT_PUBLIC_DOCS_URL=https://docs.hawiyat.org
NEXT_PUBLIC_BLOG_URL=https://blog.hawiyat.org

# ============================================
# PostHog (required: instrumentation-client.ts
# throws in dev when these are missing)
# ============================================
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ============================================
# WhatsApp
# Public number used for wa.me deep links (must match
# WHATSAPP_NUMBER in lib/contact.ts).
# ============================================
NEXT_PUBLIC_WHATSAPP_NUMBER=213559555951

# Server-side WhatsApp notification API (optional: lib/email-utils.ts
# sendWhatsAppNotification falls back silently when unset).
WHATSAPP_API_URL=
WHATSAPP_BASIC_AUTH=

# ============================================
# Email / SMTP (optional at runtime: order emails
# are skipped with a console error when unset)
# ============================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user_here
SMTP_PASS=your_smtp_password_here
SMTP_FROM=contact@hawiyat.org

# ============================================
# Telegram (optional: order route notification)
# ============================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
