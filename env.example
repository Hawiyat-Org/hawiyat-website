# ============================================
# Database
# ============================================
DATABASE_URL=postgresql://user:password@localhost:5432/hawiyat_db

# ============================================
# NextAuth
# ============================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here

# ============================================
# App URLs
# ============================================
NEXT_PUBLIC_APP_NAME=Hawiyat
NEXT_PUBLIC_URL=https://hawiyat.org
NEXT_PUBLIC_APP_URL=https://app.hawiyat.org
NEXT_PUBLIC_DOCS_URL=https://docs.hawiyat.org
NEXT_PUBLIC_BLOG_URL=https://blog.hawiyat.org

# ============================================
# OAuth Providers
# ============================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_ID=
GITHUB_SECRET=
BITBUCKET_CLIENT_ID=
BITBUCKET_CLIENT_SECRET=

# ============================================
# Email (SMTP)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ============================================
# Telegram Notifications
# ============================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================
# AI (Gemini)
# ============================================
GEMINI_API_KEY=

# ============================================
# WhatsApp
# ============================================
NEXT_PUBLIC_WHATSAPP_NUMBER=213559555951

# ============================================
# PayPal
# ============================================
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ============================================
# Payoneer
# ============================================
PAYONEER_API_URL=
PAYONEER_API_KEY=
