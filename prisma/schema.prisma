generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentMethod {
  CCP
  BARIDI_MOB
  USD
}

model Order {
  id               String         @id @default(cuid())
  serviceId        String         @map("service_id")
  serviceName      String         @map("service_name")
  customerName     String         @map("customer_name")
  customerEmail    String         @map("customer_email")
  customerPhone    String?        @map("customer_phone")
  preferredPayment PaymentMethod? @map("preferred_payment")
  notes            String?        @db.Text
  status           OrderStatus    @default(PENDING)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  
  @@index([customerEmail])
  @@index([status])
  @@index([serviceId])
  @@map("orders")
}

model EmailSubscription {
  id         String   @id @default(cuid())
  email      String   @unique
  createdAt  DateTime @default(now()) @map("created_at")
  
  @@index([email])
  @@map("email_subscriptions")
}

model BootcampRegistration {
  id          String   @id @default(cuid())
  fullName    String   @map("full_name")
  email       String
  phone       String
  university  String
  major       String
  graduationYear String @map("graduation_year")
  topic       String?  @db.Text
  deadline    DateTime?
  status      OrderStatus @default(PENDING)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  @@index([email])
  @@index([status])
  @@map("bootcamp_registrations")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model VerificationCode {
  id        String   @id @default(cuid())
  email     String   @unique
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@map("VerificationCode")
}

model BlockedDate {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  startTime String?  @map("start_time")
  endTime   String?  @map("end_time")
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([date])
  @@map("blocked_dates")
}

model Booking {
  id                String        @id @default(cuid())
  startTime         DateTime      @map("start_time")
  endTime           DateTime      @map("end_time")
  timezone          String        @default("UTC")
  status            BookingStatus @default(CONFIRMED)
  customerName      String        @map("customer_name")
  customerEmail     String        @map("customer_email")
  customerPhone     String?       @map("customer_phone")
  notes             String?
  internalNotes     String?       @map("internal_notes")
  cancelledAt       DateTime?     @map("cancelled_at")
  cancellationReason String?      @map("cancellation_reason")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  serviceId         String?
  service           Service?      @relation(fields: [serviceId], references: [id])

  @@index([customerEmail])
  @@index([serviceId])
  @@index([startTime, endTime])
  @@index([status])
  @@map("bookings")
}

model BusinessHours {
  id        String   @id @default(cuid())
  dayOfWeek Int      @unique @map("day_of_week")
  isOpen    Boolean  @default(true) @map("is_open")
  startTime String   @map("start_time")
  endTime   String   @map("end_time")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("business_hours")
}

model Service {
  id          String    @id @default(cuid())
  name        String
  description String?
  duration    Int
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  bookings    Booking[]

  @@index([isActive])
  @@map("services")
}

model Waitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  ipAddress String   @map("ip_address")
  userAgent String   @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@map("waitlist")
}
